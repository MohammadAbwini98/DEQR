{
  "name": "deqr",
  "version": "0.1.0",
  "description": "Desktop Optical Transfer via Fountain-Coded Animated QR Stream",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'lint not configured'",
    "doctor": "node scripts/ai/doctor.js",
    "drift-check": "node scripts/ai/check-adapter-drift.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "canvas": "^3.2.3",
    "electron": "^36.0.0",
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "author": "",
  "license": "UNLICENSED"
}
