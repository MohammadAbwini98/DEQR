{
  "name": "deqr",
  "version": "0.1.0",
  "description": "Desktop Optical Transfer via Fountain-Coded Animated QR Stream",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'lint not configured'",
    "doctor": "node scripts/ai/doctor.js",
    "drift-check": "node scripts/ai/check-adapter-drift.js",
    "test:packaged": "node scripts/ci/verify-packaged-renderer.js",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.deqr.app",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "asar": "^3.2.0",
    "canvas": "^3.2.3",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "author": "",
  "license": "UNLICENSED"
}
