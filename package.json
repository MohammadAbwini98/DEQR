{
  "name": "deqr",
  "version": "0.1.0",
  "description": "Desktop Optical Transfer via Fountain-Coded Animated QR Stream",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'lint not configured'",
    "doctor": "node scripts/ai/doctor.js",
    "drift-check": "node scripts/ai/check-adapter-drift.js",
    "vectors:generate": "npx --yes tsx@4.20.3 scripts/protocol/generate-vectors.ts",
    "test:packaged": "node scripts/ci/verify-packaged-renderer.js",
    "mobile-web:dev": "vite --config mobile-web/vite.config.ts",
    "mobile-web:dev:https": "vite --config mobile-web/vite.config.ts",
    "run:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-local.ps1",
    "mobile-web:typecheck": "tsc -p mobile-web/tsconfig.json --noEmit",
    "mobile-web:test": "vitest run --config mobile-web/vitest.config.ts",
    "mobile-web:build": "npm run mobile-web:typecheck && vite build --config mobile-web/vite.config.ts",
    "package": "npm run build && npm run mobile-web:build && electron-builder --dir",
    "dist": "npm run build && npm run mobile-web:build && electron-builder"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1"
  },
  "build": {
    "appId": "com.deqr.app",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "asar": "^3.2.0",
    "canvas": "^3.2.3",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "author": "",
  "license": "UNLICENSED"
}
