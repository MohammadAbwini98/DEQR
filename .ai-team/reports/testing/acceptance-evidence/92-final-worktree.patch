+  body { background: #0d141d; }
+  button { border-color: #38495c; color: #edf3fa; background: #182431; box-shadow: none; }
+  button.danger { border-color: #9f5258; color: #ffb4b7; background: #31191e; }
+  .brand strong,
+  h1 { color: #edf3fa; }
+  .brand small,
+  .version,
+  .install-note,
+  p { color: #aebdcd; }
+  .card { border-color: #2c3c4d; background: rgba(22, 33, 46, .94); box-shadow: none; }
+  .trust-note { border-color: #304152; background: rgba(16, 26, 37, .72); }
+  .trust-note strong { color: #e5edf6; }
+  .progress { background: #263849; }
+  .verified-file { border-color: #315e4a; background: #132b22; }
+  .verified-file span:not(.success-mark),
+  .verified-file small { color: #afc8b9; }
+  .verified-file strong { color: #d5f1e1; }
+  .scan-details { border-color: #2c3c4d; }
+  .scan-details summary { color: #c6d3e1; }
+  dl div { background: #111d29; }
+  dt { color: #91a3b7; }
+  dd { color: #d9e3ee; }
+  .action-dock { border-color: #2c3c4d; background: rgba(13, 20, 29, .93); }
