+  min-height: 32px;
+  align-items: center;
+  gap: 7px;
+  padding: 6px 10px;
+  border: 1px solid rgba(255, 255, 255, .22);
+  border-radius: 999px;
+  color: #ffffff;
+  background: rgba(8, 13, 19, .7);
+  font-size: .76rem;
+  font-weight: 700;
+  text-shadow: 0 1px 2px #000000;
