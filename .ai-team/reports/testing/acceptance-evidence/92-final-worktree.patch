+  color: #567064;
+  font-size: .77rem;
+}
+
+.verified-file strong {
+  overflow-wrap: anywhere;
+  color: #183d2b;
+  font-size: .95rem;
+}
+
+.scan-details {
+  margin-top: 17px;
+  border-top: 1px solid #e1e8ef;
+}
+
+.scan-details summary {
