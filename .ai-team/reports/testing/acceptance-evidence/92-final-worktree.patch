+
+.camera-indicator span {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: #8bdcab;
+}
+
+.camera-preparing .camera-indicator span { background: #ffd166; }
+.camera-error .camera-indicator span,
+.camera-idle .camera-indicator span { background: #bdc7d5; }
+
+.camera-caption {
