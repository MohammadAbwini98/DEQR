+  gap: 3px;
+  padding: 14px 16px 15px;
+  color: #e9f0f7;
+}
+
+.camera-caption strong { font-size: .9rem; }
+.camera-caption span { color: #b7c7d7; font-size: .78rem; }
+
+.status-card { padding: 20px; }
