+
+@media (prefers-contrast: more) {
+  .card,
+  .trust-note,
+  .verified-file,
+  button { border-width: 2px; }
+  .scan-guide { border-width: 3px; box-shadow: 0 0 0 100vmax rgba(0, 0, 0, .48); }
