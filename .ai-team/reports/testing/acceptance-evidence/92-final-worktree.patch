+  .action-dock { padding-right: calc(28px + env(safe-area-inset-right)); padding-left: calc(28px + env(safe-area-inset-left)); }
+  .home-actions .primary { width: min(100%, 380px); }
+}
+
+@media (hover: hover) and (pointer: fine) {
