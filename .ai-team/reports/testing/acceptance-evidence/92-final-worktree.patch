+}
+
+dl {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 8px;
+  margin: 0 0 2px;
+}
+
+dl div {
+  min-width: 0;
+  padding: 11px;
+  border-radius: 12px;
+  background: #f3f6f9;
+}
+
+dl .wide { grid-column: 1 / -1; }
+
+dt {
+  color: var(--detail-label);
+  font-size: .72rem;
+  font-weight: 700;
+}
+
+dd {
+  overflow-wrap: anywhere;
+  margin: 4px 0 0;
+  color: #2d4057;
+  font-size: .82rem;
+  font-weight: 700;
